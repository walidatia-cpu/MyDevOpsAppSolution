@model MyDevOpsApp.Areas.Admin.Models.UsersListReportViewModel
@{
    ViewData["Title"] = "سجل المستخدمين المسجلين وحركة الدخول";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.3rem 0.8rem; border-radius: 9999px; color: #38bdf8; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.6rem;">
            🛡️ إدارة الحسابات والأمان (User Audit & Activity)
        </div>
        <h1 style="font-size: 1.85rem; font-weight: 800; margin-bottom: 0.35rem;">
            👥 سجل المستخدمين المسجلين وتواريخ الدخول
        </h1>
        <p style="color: var(--text-secondary); line-height: 1.6;">
            حصر كامل لكافة الحسابات المسجلة بالنظام مع تاريخ إنشاء كل حساب، وتاريخ ووقت آخر تسجيل دخول، وحالة المصادقة الثنائية (2FA).
        </p>
    </div>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <button type="button" onclick="window.print()" class="btn-action-subtle" style="padding: 0.6rem 1.1rem;">
            🖨️ طباعة السجل
        </button>
        <a asp-controller="Account" asp-action="RegisterEmployee" asp-area="" target="_blank" class="btn btn-admin" style="padding: 0.6rem 1.25rem;">
            ➕ تسجيل حساب موظف جديد
        </a>
    </div>
</div>

<!-- بطاقات الإحصائيات العلوية -->
<div class="metrics-grid" style="margin-bottom: 2rem;">
    <!-- إجمالي المستخدمين -->
    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(99, 102, 241, 0.15); color: var(--primary);">
            👥
        </div>
        <div class="metric-info">
            <h4>إجمالي المستخدمين المسجلين</h4>
            <div class="metric-value">@Model.TotalUsersCount</div>
        </div>
    </div>

    <!-- نشطين مؤخراً -->
    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
            🟢
        </div>
        <div class="metric-info">
            <h4>سجلوا دخول مؤخراً (آخر 7 أيام)</h4>
            <div class="metric-value" style="color: var(--success);">@Model.ActiveRecentlyCount</div>
        </div>
    </div>

    <!-- مسؤولو النظام -->
    <div class="metric-card">
        <div class="metric-icon" style="background: var(--danger-bg); color: var(--danger);">
            🛡️
        </div>
        <div class="metric-info">
            <h4>مسؤولو النظام (Admins)</h4>
            <div class="metric-value" style="color: var(--danger);">@Model.AdminsCount</div>
        </div>
    </div>

    <!-- حسابات الموظفين -->
    <div class="metric-card">
        <div class="metric-icon" style="background: rgba(14, 165, 233, 0.15); color: #38bdf8;">
            💼
        </div>
        <div class="metric-info">
            <h4>حسابات الموظفين (Employees)</h4>
            <div class="metric-value" style="color: #38bdf8;">@Model.EmployeesCount</div>
        </div>
    </div>
</div>

<!-- جدول المستخدمين المسجلين -->
<div class="panel-card">
    <div class="panel-header">
        <h2 class="panel-title">
            📋 قائمة المستخدمين المسجلين وتفاصيل الجلسات (@Model.Users.Count مستخدم)
        </h2>
        <span class="badge badge-info">تحديث لحظي</span>
    </div>

    <div style="overflow-x: auto;">
        <table class="custom-table" id="table-users-list">
            <thead>
                <tr>
                    <th>المستخدم</th>
                    <th>الرقم القومي / رقم الملف</th>
                    <th>الإدارة / القسم</th>
                    <th>الدور والصلاحية</th>
                    <th>تاريخ ووقت التسجيل</th>
                    <th>تاريخ آخر تسجيل دخول</th>
                    <th>الحالة والنشاط</th>
                    <th>أمان 2FA</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <!-- المستخدم والبريد -->
                        <td>
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <div style="width: 38px; height: 38px; border-radius: 50%; background: @(user.Role == "Admin" ? "rgba(244, 63, 94, 0.15)" : "rgba(56, 189, 248, 0.15)"); color: @(user.Role == "Admin" ? "#fb7185" : "#38bdf8"); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1rem;">
                                    @(string.IsNullOrWhiteSpace(user.FullName) ? "U" : user.FullName.Trim().Substring(0, 1))
                                </div>
                                <div>
                                    <strong style="color: var(--text-primary); font-size: 0.95rem; display: block;">@user.FullName</strong>
                                    <span style="color: var(--text-muted); font-size: 0.8rem; direction: ltr; display: inline-block;">@user.Email</span>
                                </div>
                            </div>
                        </td>

                        <!-- الرقم القومي ورقم الملف -->
                        <td>
                            @if (!string.IsNullOrEmpty(user.NationalId))
                            {
                                <div style="font-family: monospace; font-size: 0.88rem; color: var(--text-primary); direction: ltr; text-align: right;">
                                    @user.NationalId
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(user.PaymentNumber))
                            {
                                <small style="color: var(--info); font-weight: 600;">ملف: #@user.PaymentNumber</small>
                            }
                            @if (string.IsNullOrEmpty(user.NationalId) && string.IsNullOrEmpty(user.PaymentNumber))
                            {
                                <span style="color: var(--text-muted); font-size: 0.85rem;">—</span>
                            }
                        </td>

                        <!-- الإدارة -->
                        <td>
                            <span style="font-size: 0.88rem; color: var(--text-secondary);">
                                @(string.IsNullOrWhiteSpace(user.Department) ? "عامة" : user.Department)
                            </span>
                        </td>

                        <!-- الدور -->
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge" style="background: rgba(244, 63, 94, 0.15); color: #fda4af; border: 1px solid rgba(244, 63, 94, 0.35);">
                                    🛡️ مدير النظام
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-info">
                                    👤 موظف
                                </span>
                            }
                        </td>

                        <!-- تاريخ التسجيل -->
                        <td data-order="@user.CreatedAt.ToString("yyyyMMddHHmmss")">
                            <strong style="font-size: 0.88rem; color: var(--text-primary); display: block;">
                                @user.CreatedAt.ToString("yyyy-MM-dd")
                            </strong>
                            <small style="color: var(--text-muted); font-size: 0.78rem;">
                                @user.CreatedAt.ToString("hh:mm tt")
                            </small>
                        </td>

                        <!-- تاريخ آخر تسجيل دخول -->
                        <td data-order="@(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("yyyyMMddHHmmss") : "00000000000000")">
                            @if (user.LastLoginAt.HasValue)
                            {
                                <strong style="font-size: 0.88rem; color: #38bdf8; display: block;">
                                    @user.LastLoginAt.Value.ToString("yyyy-MM-dd")
                                </strong>
                                <small style="color: var(--text-muted); font-size: 0.78rem;">
                                    @user.LastLoginAt.Value.ToString("hh:mm tt")
                                </small>
                            }
                            else
                            {
                                <span style="color: var(--text-muted); font-size: 0.85rem; font-style: italic;">
                                    لم يسجل دخول بعد
                                </span>
                            }
                        </td>

                        <!-- الحالة والنشاط -->
                        <td>
                            @if (user.LastLoginAt.HasValue)
                            {
                                <span class="badge" style="background: @(user.IsRecentlyActive ? "rgba(16, 185, 129, 0.15)" : "var(--hover-overlay)"); color: @(user.IsRecentlyActive ? "var(--success)" : "var(--text-muted)"); border: 1px solid @(user.IsRecentlyActive ? "rgba(16, 185, 129, 0.3)" : "var(--border-color)"); font-size: 0.8rem;">
                                    @user.LastLoginTimeAgo
                                </span>
                            }
                            else
                            {
                                <span class="badge" style="background: var(--danger-bg); color: var(--danger); border: 1px solid var(--danger); font-size: 0.8rem;">
                                    حساب جديد
                                </span>
                            }
                        </td>

                        <!-- 2FA -->
                        <td>
                            @if (user.IsTwoFactorEnabled)
                            {
                                <span class="badge badge-success" title="المصادقة الثنائية مفعلة">
                                    🔐 مفعل
                                </span>
                            }
                            else
                            {
                                <span style="color: var(--text-muted); font-size: 0.82rem;">
                                    غير مفعل
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            if ($('#table-users-list').length) {
                $('#table-users-list').DataTable({
                    language: {
                        search: "🔍 بحث فوري في المستخدمين:",
                        searchPlaceholder: "الاسم، البريد، الرقم القومي، الإدارة...",
                        lengthMenu: "عرض _MENU_ مستخدم لكل صفحة",
                        info: "عرض _START_ إلى _END_ من أصل _TOTAL_ مستخدم",
                        infoEmpty: "لا يوجد مستخدمين مسجلين",
                        infoFiltered: "(تمت التصفية من أصل _MAX_ مستخدم)",
                        zeroRecords: "لم يتم العثور على أية نتائج مطابقة",
                        paginate: {
                            first: "الأول",
                            previous: "السابق",
                            next: "التالي",
                            last: "الأخير"
                        }
                    },
                    pageLength: 25,
                    lengthMenu: [10, 25, 50, 100, 250],
                    responsive: true,
                    order: [[4, "desc"]], // الترتيب الافتراضي بحسب تاريخ التسجيل تنازلياً
                    columnDefs: [
                        { orderable: false, targets: [7] }
                    ]
                });
            }
        });
    </script>
}
