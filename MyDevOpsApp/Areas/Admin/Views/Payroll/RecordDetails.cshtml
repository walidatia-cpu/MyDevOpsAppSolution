@model MyDevOpsApp.Data.Entities.PayrollRecord
@{
    ViewData["Title"] = $"تفاصيل مفردات {Model.PayrollBatch.PayrollType} - {Model.EmployeeName}";
    var earnings = Model.Items.Where(i => i.ItemType == "Earning").ToList();
    var deductions = Model.Items.Where(i => i.ItemType == "Deduction").ToList();
}

<div style="margin-bottom: 2rem;">
    <a asp-action="Report" asp-route-year="@Model.PayrollBatch.Year" asp-route-month="@Model.PayrollBatch.Month" asp-route-type="@Model.PayrollBatch.PayrollType"
       class="btn" style="background: rgba(255, 255, 255, 0.06); color: var(--text-secondary); margin-bottom: 1rem; font-size: 0.85rem;">
        &rarr; العودة لتقرير شهر @Model.PayrollBatch.Month / @Model.PayrollBatch.Year
    </a>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.25rem;">
                بيان مفردات @Model.PayrollBatch.PayrollType (شهر @Model.PayrollBatch.Month / @Model.PayrollBatch.Year)
            </h1>
            <p style="color: var(--text-secondary);">
                تفاصيل كافة بنود الاستحقاقات والاستقطاعات للموظف: <strong>@Model.EmployeeName</strong>
            </p>
        </div>
        <div>
            <button onclick="window.print()" class="btn" style="background: rgba(255, 255, 255, 0.08); color: #fff;">
                🖨️ طباعة البيان
            </button>
        </div>
    </div>
</div>

<!-- بطاقة بيانات الموظف والبنك -->
<div class="panel-card" style="margin-bottom: 1.5rem; background: rgba(99, 102, 241, 0.03); border-color: rgba(99, 102, 241, 0.25);">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; font-size: 0.9rem;">
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">اسم الموظف:</span>
            <strong style="font-size: 1.05rem;">@Model.EmployeeName</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">رقم الصرف / الملف:</span>
            <strong style="color: #a5b4fc;">#@Model.PaymentNumber</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">الرقم القومي:</span>
            <strong style="font-family: monospace;">@Model.NationalId</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">الإدارة:</span>
            <strong>@Model.Department</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">الدرجة الوظيفية:</span>
            <strong>@Model.Grade</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">الرقم التأميني:</span>
            <strong style="font-family: monospace;">@Model.InsuranceNumber</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">البنك والفرع:</span>
            <strong>@Model.BankName (@Model.Branch)</strong>
        </div>
        <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem;">نوع الصرف:</span>
            <span class="badge badge-primary">@Model.PaymentType</span>
        </div>
    </div>
</div>

<!-- شبكة الجداول: الاستحقاقات والاستقطاعات -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
    <!-- جدول الاستحقاقات -->
    <div class="panel-card" style="margin-bottom: 0;">
        <div class="panel-header" style="border-bottom-color: rgba(16, 185, 129, 0.3);">
            <h2 class="panel-title" style="color: var(--success);">
                📈 بنود الاستحقاقات (@earnings.Count بند)
            </h2>
            <span class="badge badge-success">إجمالي: @Model.TotalEarnings.ToString("N2") ج.م</span>
        </div>
        <table class="custom-table">
            <thead>
                <tr>
                    <th>كود</th>
                    <th>البيان</th>
                    <th>القيمة</th>
                    <th>الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (earnings.Count == 0)
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted);">لا توجد بنود استحقاقات مسجلة.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in earnings)
                    {
                        <tr>
                            <td style="color: var(--text-muted); font-size: 0.85rem;">@item.Code</td>
                            <td style="font-weight: 500;">@item.Name</td>
                            <td style="color: var(--text-secondary);">@(item.Value.HasValue ? item.Value.Value.ToString("N2") : "-")</td>
                            <td style="font-weight: 600; color: var(--success);">@(item.Total.HasValue ? item.Total.Value.ToString("N2") : "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- جدول الاستقطاعات -->
    <div class="panel-card" style="margin-bottom: 0;">
        <div class="panel-header" style="border-bottom-color: rgba(239, 68, 68, 0.3);">
            <h2 class="panel-title" style="color: var(--danger);">
                📉 بنود الاستقطاعات (@deductions.Count بند)
            </h2>
            <span class="badge badge-danger" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                إجمالي: @Model.TotalDeductions.ToString("N2") ج.م
            </span>
        </div>
        <table class="custom-table">
            <thead>
                <tr>
                    <th>كود</th>
                    <th>البيان</th>
                    <th>القيمة</th>
                    <th>الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (deductions.Count == 0)
                {
                    <tr>
                        <td colspan="4" style="text-align: center; color: var(--text-muted);">لا توجد استقطاعات مسجلة.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in deductions)
                    {
                        <tr>
                            <td style="color: var(--text-muted); font-size: 0.85rem;">@item.Code</td>
                            <td style="font-weight: 500;">@item.Name</td>
                            <td style="color: var(--text-secondary);">@(item.Value.HasValue ? item.Value.Value.ToString("N2") : "-")</td>
                            <td style="font-weight: 600; color: var(--danger);">@(item.Total.HasValue ? item.Total.Value.ToString("N2") : "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- بطاقة الملخص الإجمالي النهائي -->
<div class="panel-card" style="background: linear-gradient(135deg, rgba(17, 24, 39, 0.9) 0%, rgba(30, 41, 59, 0.9) 100%); border: 1px solid var(--border-glass);">
    <div style="display: flex; justify-content: space-around; align-items: center; flex-wrap: wrap; gap: 1.5rem; text-align: center;">
        <div>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">إجمالي الاستحقاقات:</div>
            <div style="font-size: 1.3rem; font-weight: 700; color: var(--success);">@Model.TotalEarnings.ToString("N2") ج.م</div>
        </div>
        <div style="font-size: 1.5rem; color: var(--text-muted);">-</div>
        <div>
            <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 0.25rem;">إجمالي الاستقطاعات:</div>
            <div style="font-size: 1.3rem; font-weight: 700; color: var(--danger);">@Model.TotalDeductions.ToString("N2") ج.م</div>
        </div>
        <div style="font-size: 1.5rem; color: var(--text-muted);">=</div>
        <div>
            <div style="font-size: 0.9rem; color: #93c5fd; font-weight: 600; margin-bottom: 0.25rem;">صافي المستحق للصرف:</div>
            <div style="font-size: 1.8rem; font-weight: 800; color: #38bdf8; letter-spacing: -0.5px;">
                @Model.NetAmount.ToString("N2") ج.م
            </div>
        </div>
    </div>
</div>
