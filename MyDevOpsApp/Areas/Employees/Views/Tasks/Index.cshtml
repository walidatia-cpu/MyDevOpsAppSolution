@model IEnumerable<MyDevOpsApp.Areas.Employees.Models.TaskItemModel>
@{
    ViewData["Title"] = "قائمة المهام - بوابة الموظفين";
}

<div style="margin-bottom: 2rem;">
    <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem;">
        قائمة المهام والواجبات (My Tasks)
    </h1>
    <p style="color: var(--text-secondary);">
        تتبع المهام المسندة إليك وتحديث مراحل الإنجاز.
    </p>
</div>

<div class="panel-card">
    <div class="panel-header">
        <h2 class="panel-title">📋 جميع المهام المسندة</h2>
        <span class="badge badge-info">إجمالي المهام: @Model.Count()</span>
    </div>

    <div style="overflow-x: auto;">
        <table class="custom-table">
            <thead>
                <tr>
                    <th>المعرف (#)</th>
                    <th>عنوان المهمة</th>
                    <th>الوصف</th>
                    <th>الأولوية</th>
                    <th>الموعد النهائي</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td style="color: var(--text-muted); font-weight: bold;">#@task.Id</td>
                        <td style="font-weight: 600;">@task.Title</td>
                        <td style="color: var(--text-secondary); font-size: 0.9rem;">@task.Description</td>
                        <td>
                            @if (task.Priority == "عالية")
                            {
                                <span class="badge badge-warning">عالية</span>
                            }
                            else
                            {
                                <span class="badge badge-primary">@task.Priority</span>
                            }
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.85rem;">@task.DueTime</td>
                        <td>
                            @if (task.Status == "مكتملة")
                            {
                                <span class="badge badge-success">مكتملة</span>
                            }
                            else if (task.Status == "قيد التنفيذ")
                            {
                                <span class="badge badge-info">قيد التنفيذ</span>
                            }
                            else
                            {
                                <span class="badge" style="background: rgba(255,255,255,0.06); color: var(--text-secondary);">@task.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
