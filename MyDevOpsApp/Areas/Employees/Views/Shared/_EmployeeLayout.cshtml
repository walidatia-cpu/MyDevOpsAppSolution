<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - بوابة الموظفين (Employees)</title>
    <meta name="description" content="بوابة الخدمة الذاتية للموظفين - MyDevOpsApp Employees Area" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            var key = 'app-theme-preference';
            var saved = localStorage.getItem(key) || 'light';
            document.documentElement.setAttribute('data-theme', saved);

            var lastClick = 0;
            window.toggleTheme = function () {
                var now = Date.now();
                if (now - lastClick < 250) return;
                lastClick = now;

                var current = (document.documentElement.getAttribute('data-theme') || 'light').toLowerCase();
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                try {
                    localStorage.setItem(key, next);
                } catch (e) {}
                if (window.updateThemeUI) {
                    window.updateThemeUI(next);
                }
            };
        })();
    </script>
</head>
<body>
    <header class="main-header">
        <nav class="navbar" id="employee-top-navbar">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <a class="brand-logo" asp-area="Employees" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-badge" style="background: var(--employee-gradient);">Employee Portal</span>
                    <span>بوابة الموظف</span>
                </a>
            </div>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <button type="button" class="theme-toggle-btn" onclick="toggleTheme()" aria-label="تبديل المظهر" title="تبديل الوضع (داكن / فاتح)">
                    <span class="theme-segmented">
                        <span class="theme-opt opt-dark">🌙 داكن</span>
                        <span class="theme-opt opt-light">☀️ فاتح</span>
                    </span>
                </button>
                <button id="btn-clock-in" class="btn" style="background: rgba(2, 132, 199, 0.12); border: 1px solid rgba(2, 132, 199, 0.25); color: #38bdf8; font-size: 0.85rem; padding: 0.45rem 1rem; white-space: nowrap;">
                    ⏱️ تسجيل الحضور اليومي
                </button>
                <span class="user-badge">👤 @(User.Identity?.Name ?? "موظف")</span>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link" id="link-employee-exit-portal">
                    🌐 البوابة
                </a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-logout" title="تسجيل الخروج">
                        خروج 🚪
                    </button>
                </form>
            </div>
        </nav>
    </header>

    <div class="area-layout-container">
        <!-- القائمة الجانبية للموظف -->
        <aside class="area-sidebar" id="employee-sidebar">
            <div class="sidebar-brand">
                <div class="sidebar-title">
                    <span>💼 بوابة الموظفين</span>
                </div>
                <small style="color: var(--text-muted);">Area: /Employees [Protected]</small>
            </div>
            <ul class="sidebar-menu">
                <li class="sidebar-menu-item">
                    <a asp-area="Employees" asp-controller="Dashboard" asp-action="Index" id="emp-menu-dashboard">
                        💵 <span>مفردات المرتبات والحوافز</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-area="" asp-controller="Account" asp-action="Manage2fa" id="emp-menu-2fa">
                        🔐 <span>أمان الحساب (2FA)</span>
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="sidebar-menu-item">
                        <a asp-area="Admin" asp-controller="Payroll" asp-action="Report" id="emp-menu-switch-admin">
                            🛡️ <span>إدارة المرتبات (Admin)</span>
                        </a>
                    </li>
                }
            </ul>
            <div class="sidebar-footer">
                <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--employee-accent);"></span>
                    حساب الموظف متصل
                </div>
            </div>
        </aside>

        <!-- المحتوى الرئيسي للموظف -->
        <main class="area-main-content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
