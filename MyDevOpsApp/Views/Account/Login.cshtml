@model MyDevOpsApp.Models.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول - MyDevOpsApp";
}

<div class="container" style="max-width: 520px; padding-top: 3rem; padding-bottom: 3rem;">
    <!-- كارت تسجيل الدخول -->
    <div class="panel-card" style="padding: 2.5rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); border: 1px solid var(--border-glass);">
        <div style="text-align: center; margin-bottom: 2rem;">
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: var(--radius-md); background: var(--primary-gradient); color: #fff; font-size: 1.8rem; margin-bottom: 1rem; box-shadow: var(--shadow-glow);">
                🔐
            </div>
            <h1 style="font-size: 1.75rem; font-weight: 800; margin-bottom: 0.5rem;">
                تسجيل الدخول
            </h1>
            <p style="color: var(--text-secondary); font-size: 0.95rem;">
                أدخل بيانات حسابك للوصول إلى لوحة الإدارة أو بوابة الموظف
            </p>
        </div>

        <!-- رسائل الخطأ -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); border-radius: var(--radius-sm); padding: 0.85rem 1rem; margin-bottom: 1.5rem; color: #fca5a5; font-size: 0.9rem;">
                <div asp-validation-summary="All" style="list-style: none; margin: 0; padding: 0;"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" id="login-form">
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 1.25rem;">
                <label asp-for="Email" style="display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem;">
                    البريد الإلكتروني
                </label>
                <input asp-for="Email" id="input-email" class="form-control" placeholder="name@company.com"
                       style="width: 100%; padding: 0.8rem 1rem; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: #fff; font-size: 0.95rem; outline: none; transition: border-color var(--transition-fast);" />
                <span asp-validation-for="Email" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div style="margin-bottom: 1.25rem;">
                <label asp-for="Password" style="display: block; font-weight: 600; margin-bottom: 0.5rem; font-size: 0.9rem;">
                    كلمة المرور
                </label>
                <input asp-for="Password" id="input-password" type="password" class="form-control" placeholder="••••••••"
                       style="width: 100%; padding: 0.8rem 1rem; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-color); border-radius: var(--radius-sm); color: #fff; font-size: 0.95rem; outline: none; transition: border-color var(--transition-fast);" />
                <span asp-validation-for="Password" style="color: var(--danger); font-size: 0.8rem;"></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.9rem; color: var(--text-secondary);">
                    <input asp-for="RememberMe" id="input-remember-me" type="checkbox" style="width: 16px; height: 16px; accent-color: var(--primary);" />
                    <span>تذكرني على هذا الجهاز</span>
                </label>
            </div>

            <button type="submit" id="btn-submit-login" class="btn" style="width: 100%; padding: 0.85rem; font-size: 1.05rem; background: var(--primary-gradient); color: #fff; box-shadow: var(--shadow-glow);">
                دخول للنظام &larr;
            </button>

            <div style="text-align: center; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-secondary);">
                موظف جديد وتريد تفعيل حسابك؟
                <a asp-action="RegisterEmployee" style="color: #38bdf8; font-weight: 600; text-decoration: underline; margin-right: 0.25rem;">
                    سجل برقمك القومي ورقم الملف &larr;
                </a>
            </div>
        </form>
    </div>
</div>
